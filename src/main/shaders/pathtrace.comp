#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

/*
 * Path tracer using hardware ray tracing (RT cores) through ray queries.
 * The scene is a top-level acceleration structure (TLAS) over instances; each instance
 * points at a BLAS: a triangle mesh, or a single AABB for an analytic unit sphere.
 * Per-instance data (mesh buffers, material) lives in InstanceBuffer.
 */

// --- Data layout (must match RayTracingScene.java / VulkanEngine.java) ---
struct Ray { vec3 origin; vec3 dir; };

struct InstanceInfo {             // 64 bytes, written by RayTracingScene.writeInstanceInfo
    uint64_t vertexAddress;       // triangles: float x, y, z per vertex (object space)
    uint64_t indexAddress;        // triangles: uint, three per triangle
    vec4     albedoRoughness;     // rgb = albedo, a = roughness (metal)
    vec4     emissionIor;         // rgb = emitted radiance, a = index of refraction (glass)
    uint     materialType;        // MAT_*
    uint     geometryType;        // GEOMETRY_*
    uint     pad0;
    uint     pad1;
};

layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer Positions { float v[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer Indices { uint i[]; };

// --- Bindings ---
layout(rgba8, set = 0, binding = 0) uniform restrict writeonly image2D resultImage;
layout(set = 0, binding = 1) uniform accelerationStructureEXT topLevelAS;
layout(std430, set = 0, binding = 2) readonly buffer InstanceBuffer { InstanceInfo instances[]; };
layout(std140, set = 0, binding = 3) uniform FrameUBO {
    vec4  origin;            // camera, xyz used
    vec4  lowerLeft;
    vec4  horizontal;
    vec4  vertical;
    uint  sampleIndex;       // samples accumulated before this frame
    uint  maxBounces;
    uint  skyEnabled;
    uint  lightCount;
    float exposure;          // stops (EV)
    float time;              // seconds, for animation
    vec4  blackHole;         // xyz = position, w = mass M (0 = no black hole)
    vec4  blackHoleDisk;     // x = inner radius, y = outer radius, z = brightness, w = gravity on (1) / off (0)
    vec4  compactSurface;    // x = surface radius (0 = black hole), y = spin period, z = magnetic tilt (rad),
                             // w = flags: 1 split view, 2 pulsar beams
} frame;
layout(rgba32f, set = 0, binding = 4) uniform restrict image2D accumImage; // running average (linear)

struct Light {               // 48 bytes, written by RayTracingScene.writeLights
    vec4 centerRadius;       // emissive sphere: world center, radius
    vec4 emission;           // rgb = emitted radiance
    uint instance;           // its instance index, to recognize it in shadow rays
    uint pad0, pad1, pad2;
};
layout(std430, set = 0, binding = 5) readonly buffer LightBuffer { Light lights[]; };

// --- Constants ---
const float T_MIN = 0.001;
const float T_MAX = 1.0e6;
const float PI = 3.14159265359;
// Must match Material.Type ordinals and RayTracingScene.GEOMETRY_*
const uint MAT_DIFFUSE  = 0u;
const uint MAT_METAL    = 1u;
const uint MAT_GLASS    = 2u;
const uint MAT_EMISSIVE = 3u;
const uint GEOMETRY_TRIANGLES = 0u;
const uint GEOMETRY_SPHERE    = 1u;

// --- Random numbers (PCG hash) ---
uint seed;

uint pcg(uint v) {
    uint state = v * 747796405u + 2891336453u;
    uint word  = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float randomFloat() {
    seed = pcg(seed);
    return float(seed) / 4294967296.0; // [0, 1)
}

vec3 randomUnitVector() {
    float z = 1.0 - 2.0 * randomFloat();
    float r = sqrt(max(0.0, 1.0 - z * z));
    float phi = 2.0 * PI * randomFloat();
    return vec3(r * cos(phi), r * sin(phi), z);
}

// Sparse procedural stars (used as the background of black hole scenes, where lensing distorts them).
vec3 starField(vec3 dir) {
    vec3 p = normalize(dir) * 350.0;
    vec3 cell = floor(p);
    uint h = pcg(uint(int(cell.x) + 1000) * 73856093u ^ uint(int(cell.y) + 1000) * 19349663u
                 ^ uint(int(cell.z) + 1000) * 83492791u);
    if ((h & 1023u) > 6u) return vec3(0.0);                       // ~0.7% of cells hold a star
    vec3 center = cell + 0.5 + 0.3 * (vec3(pcg(h), pcg(h + 1u), pcg(h + 2u)) / 4294967296.0 - 0.5);
    float d = length(p - center);
    float brightness = 2.0 + 6.0 * float(pcg(h + 3u) & 255u) / 255.0;
    vec3 tint = mix(vec3(1.0, 0.85, 0.7), vec3(0.75, 0.85, 1.0), float(pcg(h + 4u) & 255u) / 255.0);
    return tint * brightness * smoothstep(0.35, 0.0, d);
}

vec3 getSkyColor(vec3 dir) {
    if (frame.skyEnabled == 0u) return frame.blackHole.w > 0.0 ? starField(dir) : vec3(0.0);
    float t = 0.5 * (normalize(dir).y + 1.0);
    return (1.0 - t) * vec3(1.0) + t * vec3(0.5, 0.7, 1.0);
}

// --- Ray queries ---

// Nearest t in (tMin, tMax) where the object-space ray o + t*d hits the unit sphere, or -1.
// d is not normalized: the instance transform may scale it, but t stays the world-space t.
float intersectUnitSphere(vec3 o, vec3 d, float tMin, float tMax) {
    float a = dot(d, d);
    float halfB = dot(o, d);
    float c = dot(o, o) - 1.0;
    float discriminant = halfB * halfB - a * c;
    if (discriminant < 0.0) return -1.0;
    float root = sqrt(discriminant);
    float t = (-halfB - root) / a;
    if (t <= tMin || t >= tMax) {
        t = (-halfB + root) / a;      // ray starts inside the sphere (glass): far side
        if (t <= tMin || t >= tMax) return -1.0;
    }
    return t;
}

// Runs a ray query to completion. Triangles are opaque and committed by the hardware;
// sphere AABB candidates are intersected here and committed with GenerateIntersection.
// (A macro, because GLSL does not allow ray query objects as inout function parameters.)
#define RUN_QUERY(query, rayTMax)                                                                       \
    while (rayQueryProceedEXT(query)) {                                                                 \
        if (rayQueryGetIntersectionTypeEXT(query, false) == gl_RayQueryCandidateIntersectionAABBEXT) {  \
            float tMaxNow = rayQueryGetIntersectionTypeEXT(query, true) == gl_RayQueryCommittedIntersectionNoneEXT \
                    ? (rayTMax) : rayQueryGetIntersectionTEXT(query, true);                             \
            float tSphere = intersectUnitSphere(rayQueryGetIntersectionObjectRayOriginEXT(query, false), \
                                                rayQueryGetIntersectionObjectRayDirectionEXT(query, false), \
                                                rayQueryGetRayTMinEXT(query), tMaxNow);                 \
            if (tSphere > 0.0) {                                                                        \
                rayQueryGenerateIntersectionEXT(query, tSphere);                                        \
            }                                                                                           \
        }                                                                                               \
    }

// --- Hit information from the committed intersection ---
struct Hit {
    float t;
    vec3  normal;      // world space, facing against the ray
    bool  frontFace;   // ray hit the outside of the surface
    uint  instance;    // index into instances[]
};

bool traceRay(Ray r, float tMax, out Hit hit) {
    rayQueryEXT query;
    rayQueryInitializeEXT(query, topLevelAS, gl_RayFlagsOpaqueEXT, 0xFF, r.origin, T_MIN, r.dir, tMax);
    RUN_QUERY(query, tMax);

    uint committed = rayQueryGetIntersectionTypeEXT(query, true);
    if (committed == gl_RayQueryCommittedIntersectionNoneEXT) {
        return false;
    }

    uint instanceIndex = uint(rayQueryGetIntersectionInstanceCustomIndexEXT(query, true));
    float t = rayQueryGetIntersectionTEXT(query, true);
    vec3 objectNormal;
    if (committed == gl_RayQueryCommittedIntersectionGeneratedEXT) {
        // Unit sphere: the normal is the object-space hit point.
        objectNormal = rayQueryGetIntersectionObjectRayOriginEXT(query, true)
                     + t * rayQueryGetIntersectionObjectRayDirectionEXT(query, true);
    } else {
        InstanceInfo instance = instances[instanceIndex];
        int primitive = rayQueryGetIntersectionPrimitiveIndexEXT(query, true);
        Indices indices = Indices(instance.indexAddress);
        Positions positions = Positions(instance.vertexAddress);
        uint i0 = indices.i[3 * primitive];
        uint i1 = indices.i[3 * primitive + 1];
        uint i2 = indices.i[3 * primitive + 2];
        vec3 v0 = vec3(positions.v[3 * i0], positions.v[3 * i0 + 1], positions.v[3 * i0 + 2]);
        vec3 v1 = vec3(positions.v[3 * i1], positions.v[3 * i1 + 1], positions.v[3 * i1 + 2]);
        vec3 v2 = vec3(positions.v[3 * i2], positions.v[3 * i2 + 1], positions.v[3 * i2 + 2]);
        objectNormal = cross(v1 - v0, v2 - v0);
    }

    // Object-space normal to world space: n_world = transpose(inverse(M)) * n = n * WorldToObject.
    mat4x3 worldToObject = rayQueryGetIntersectionWorldToObjectEXT(query, true);
    vec3 normal = normalize((objectNormal * worldToObject).xyz);
    hit.frontFace = dot(r.dir, normal) < 0.0;
    hit.normal = hit.frontFace ? normal : -normal;
    hit.t = t;
    hit.instance = instanceIndex;
    return true;
}

// --- Materials ---

float schlick(float cosine, float ior) {
    float r0 = (1.0 - ior) / (1.0 + ior);
    r0 = r0 * r0;
    return r0 + (1.0 - r0) * pow(1.0 - cosine, 5.0);
}

// Picks the next direction. Returns false if the path is absorbed.
bool scatter(vec3 inDir, Hit hit, InstanceInfo material, out vec3 attenuation, out vec3 outDir) {
    vec3 albedo = material.albedoRoughness.rgb;
    attenuation = albedo;

    if (material.materialType == MAT_DIFFUSE) {
        outDir = hit.normal + randomUnitVector(); // cosine-weighted around the normal
        if (dot(outDir, outDir) < 1e-8) outDir = hit.normal;
        outDir = normalize(outDir);
        return true;
    }
    if (material.materialType == MAT_METAL) {
        float roughness = material.albedoRoughness.a;
        outDir = normalize(reflect(inDir, hit.normal) + roughness * randomUnitVector());
        return dot(outDir, hit.normal) > 0.0;
    }
    if (material.materialType == MAT_GLASS) {
        float ior = material.emissionIor.a;
        float ratio = hit.frontFace ? 1.0 / ior : ior;
        float cosTheta = min(dot(-inDir, hit.normal), 1.0);
        float sinTheta = sqrt(1.0 - cosTheta * cosTheta);
        bool cannotRefract = ratio * sinTheta > 1.0;
        if (cannotRefract || schlick(cosTheta, ratio) > randomFloat()) {
            outDir = reflect(inDir, hit.normal);
        } else {
            outDir = refract(inDir, hit.normal, ratio);
        }
        return true;
    }
    return false; // emissive surfaces do not scatter
}

// --- Direct light from emissive spheres (next-event estimation) ---

// Orthonormal basis around n (Duff et al. 2017).
void basis(vec3 n, out vec3 t, out vec3 b) {
    float s = n.z >= 0.0 ? 1.0 : -1.0;
    float a = -1.0 / (s + n.z);
    float c = n.x * n.y * a;
    t = vec3(1.0 + s * n.x * n.x * a, s * c, -s * n.x);
    b = vec3(c, s + n.y * n.y * a, -n.y);
}

// Light arriving at a diffuse point p (normal n) from one randomly chosen sphere light,
// already divided by the sampling pdf: sample a direction in the cone the sphere subtends,
// then cast a shadow ray. This is what makes small bright lights (a sun) converge quickly,
// and what makes a planet cast its shadow in an eclipse.
vec3 sampleSphereLight(vec3 p, vec3 n) {
    uint index = min(uint(randomFloat() * float(frame.lightCount)), frame.lightCount - 1u);
    Light light = lights[index];
    vec3 toCenter = light.centerRadius.xyz - p;
    float dist2 = dot(toCenter, toCenter);
    float radius2 = light.centerRadius.w * light.centerRadius.w;
    if (dist2 <= radius2) return vec3(0.0); // inside the light

    float cosThetaMax = sqrt(max(0.0, 1.0 - radius2 / dist2));
    float cosTheta = 1.0 - randomFloat() * (1.0 - cosThetaMax);
    float sinTheta = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));
    float phi = 2.0 * PI * randomFloat();
    vec3 w = toCenter * inversesqrt(dist2);
    vec3 t, b;
    basis(w, t, b);
    vec3 dir = normalize(t * (cos(phi) * sinTheta) + b * (sin(phi) * sinTheta) + w * cosTheta);

    float cosSurface = dot(dir, n);
    if (cosSurface <= 0.0) return vec3(0.0);

    Hit shadowHit;
    if (!traceRay(Ray(p, dir), T_MAX, shadowHit) || shadowHit.instance != light.instance) {
        return vec3(0.0); // something blocks the light
    }
    float pdf = 1.0 / (2.0 * PI * (1.0 - cosThetaMax)); // uniform over the cone's solid angle
    // Diffuse BRDF (albedo / PI) is applied by the caller; one of lightCount lights was picked.
    return light.emission.rgb * cosSurface / (PI * pdf) * float(frame.lightCount);
}

// Moves a ray origin off the surface to avoid hitting the same surface again (scale-aware).
vec3 offsetOrigin(vec3 p, vec3 n, vec3 dir) {
    float eps = 1e-4 * max(1.0, max(abs(p.x), max(abs(p.y), abs(p.z))));
    return p + (dot(dir, n) > 0.0 ? n : -n) * eps;
}

// ACES filmic tone curve (Narkowicz 2015): keeps bright lights from clipping harshly.
vec3 acesFilm(vec3 x) {
    return clamp((x * (2.51 * x + 0.03)) / (x * (2.43 * x + 0.59) + 0.14), 0.0, 1.0);
}

// --- Black hole (Schwarzschild, G = c = 1) ---
// The math is derived and checked against exact results in docs/black-hole.md and
// SchwarzschildTest (Java twin: dev.demir.vulkan.physics.Schwarzschild).

const float BH_STEP_FACTOR = 0.02;   // dλ = factor * r  (same as Schwarzschild.STEP_FACTOR)
const float BH_ESCAPE = 100.0;       // in units of M: beyond this, moving outward, continue straight
const int   BH_MAX_STEPS = 3000;

const int BH_EVENT_NONE    = 0;      // continue with the returned straight ray segment
const int BH_EVENT_DISK    = 1;      // the segment ends on the accretion disk (unless geometry is hit first)
const int BH_EVENT_HORIZON = 2;      // the ray falls into the black hole: black

// Colour of a black body at temperature T (Kelvin), normalised so the largest channel is 1.
// Fit by Tanner Helland (1000 K .. 40000 K), converted from sRGB to linear.
vec3 blackbody(float T) {
    float t = clamp(T, 1000.0, 40000.0) / 100.0;
    vec3 c;
    c.r = t <= 66.0 ? 255.0 : 329.698727 * pow(t - 60.0, -0.1332047592);
    c.g = t <= 66.0 ? 99.4708025861 * log(t) - 161.1195681661 : 288.1221695283 * pow(t - 60.0, -0.0755148492);
    c.b = t >= 66.0 ? 255.0 : (t <= 19.0 ? 0.0 : 138.5177312231 * log(t - 10.0) - 305.0447927307);
    c = pow(clamp(c / 255.0, 0.0, 1.0), vec3(2.2));
    return c / max(c.r, max(c.g, c.b));
}

// Light from the thin disk at point p (relative to the hole, disk in the y = 0 plane) for a ray
// arriving along the traced direction v (camera -> disk). With gravity, the photon is shifted by
//   g = E_obs / E_emit = √(1 - 3M/r) / (1 - Ω λ),   Ω = √(M / r³) (Kepler, counter-clockwise around +y),
// λ = L_y / E of the photon (it travels along -v), and the observed brightness scales with g⁴.
// h2 = |x × v|² of the ray (0 for straight rays without gravity: then g = 1).
vec3 diskEmission(vec3 p, vec3 v, float h2, bool relativistic) {
    float M = frame.blackHole.w;
    float inner = frame.blackHoleDisk.x;
    float r = length(p);
    // Thin-disk flux profile F(r) ~ (1 - √(r_in / r)) / r³, peak at r = 49/36 r_in; T ~ F^(1/4).
    float flux = (1.0 - sqrt(inner / r)) / (r * r * r);
    float rPeak = 49.0 / 36.0 * inner;
    float fluxPeak = (1.0 / 7.0) / (rPeak * rPeak * rPeak);
    float relativeFlux = max(flux / fluxPeak, 0.0);
    float temperature = 6500.0 * pow(relativeFlux, 0.25);
    float g = 1.0;
    if (relativistic) {
        float omega = sqrt(M / (r * r * r));
        float energy = sqrt(max(dot(v, v) - 2.0 * M * h2 / (r * r * r), 1e-12)); // E² = |v|² - 2 M h² / r³
        float lambda = cross(p, -v).y / energy;
        g = sqrt(max(1.0 - 3.0 * M / r, 0.0)) / (1.0 - omega * lambda);
    }
    return blackbody(temperature * g) * frame.blackHoleDisk.z * relativeFlux * pow(g, 4.0);
}

// True if any geometry lies on the straight segment (origin, dir, length).
bool segmentHitsGeometry(vec3 origin, vec3 dir, float len) {
    rayQueryEXT query;
    rayQueryInitializeEXT(query, topLevelAS, gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT,
                          0xFF, origin, 0.0, dir, len);
    RUN_QUERY(query, len);
    return rayQueryGetIntersectionTypeEXT(query, true) != gl_RayQueryCommittedIntersectionNoneEXT;
}

const int BH_EVENT_SURFACE = 3;      // the ray ends on the neutron star's surface; 'emitted' is its light

// Rotates v around +y by angle a.
vec3 rotateY(vec3 v, float a) {
    float c = cos(a), s = sin(a);
    return vec3(c * v.x + s * v.z, v.y, -s * v.x + c * v.z);
}

// Smooth 3D value noise in [0, 1] (hash at lattice points, trilinear with smoothstep weights).
float hash3(vec3 c) {
    uvec3 q = uvec3(ivec3(c) + 4096);
    return float(pcg(q.x * 73856093u ^ pcg(q.y * 19349663u ^ pcg(q.z * 83492791u)))) / 4294967296.0;
}

float valueNoise(vec3 p) {
    vec3 i = floor(p);
    vec3 f = fract(p);
    vec3 w = f * f * (3.0 - 2.0 * f);
    float a = mix(mix(hash3(i), hash3(i + vec3(1, 0, 0)), w.x), mix(hash3(i + vec3(0, 1, 0)), hash3(i + vec3(1, 1, 0)), w.x), w.y);
    float b = mix(mix(hash3(i + vec3(0, 0, 1)), hash3(i + vec3(1, 0, 1)), w.x), mix(hash3(i + vec3(0, 1, 1)), hash3(i + vec3(1, 1, 1)), w.x), w.y);
    return mix(a, b, w.z);
}

float spinAngle() {
    return frame.compactSurface.y != 0.0 ? 6.28318530718 * frame.time / frame.compactSurface.y : 0.0;
}

// Magnetic axis in world orientation (tilted from the spin axis, turning with the star).
vec3 magneticAxis() {
    float tilt = frame.compactSurface.z;
    return rotateY(vec3(sin(tilt), cos(tilt), 0.0), spinAngle());
}

bool diagnosticView() {
    return (int(frame.compactSurface.w) & 4) != 0;
}

// Light leaving the neutron star surface at point p (relative to the star) towards the camera; the
// photon leaves along -rayDir. With gravity the light is redshifted by g = √(1 - 2M/R): temperature × g,
// brightness × g⁴.
//  - Realistic look: a hot (~10⁶ K, blue-white) surface with gentle mottling, limb darkening
//    I ∝ 0.35 + 0.65 μ (μ = cosine of the emission angle, as for a hot atmosphere), brighter polar caps.
//  - Diagnostic look: latitude-longitude grid; orange where straight light from the camera can never
//    reach (n · toCamera < R / distance), blue elsewhere.
vec3 surfaceEmission(vec3 p, vec3 rayDir, bool gravity) {
    float M = frame.blackHole.w;
    float R = frame.compactSurface.x;
    vec3 n = normalize(p);
    vec3 ns = rotateY(n, -spinAngle());                       // in the star's rotating frame
    float g = gravity ? sqrt(1.0 - 2.0 * M / R) : 1.0;
    float cap = smoothstep(cos(radians(17.0)), cos(radians(10.0)), abs(dot(n, magneticAxis())));

    vec3 radiance;
    if (diagnosticView()) {
        vec3 toCamera = frame.origin.xyz - frame.blackHole.xyz;
        float cameraDistance = length(toCamera);
        bool hiddenToStraightLight = dot(n, toCamera / cameraDistance) < R / cameraDistance;
        vec3 base = hiddenToStraightLight ? vec3(1.0, 0.42, 0.1) : vec3(0.22, 0.45, 1.0);
        float latitude = degrees(asin(clamp(ns.y, -1.0, 1.0)));
        float longitude = degrees(atan(ns.z, ns.x));
        float toLatLine = abs(fract(latitude / 15.0 + 0.5) - 0.5) * 15.0;
        float toLonLine = abs(fract(longitude / 15.0 + 0.5) - 0.5) * 15.0 * cos(radians(latitude));
        float line = 1.0 - smoothstep(0.5, 1.1, min(toLatLine, toLonLine));
        radiance = base * (0.9 - 0.6 * line) * 0.6 + cap * blackbody(11000.0 * g) * 3.0;
    } else {
        float mu = clamp(dot(n, -rayDir), 0.0, 1.0);
        float limb = 0.35 + 0.65 * mu;
        float mottle = 0.55 * valueNoise(ns * 7.0) + 0.3 * valueNoise(ns * 19.0) + 0.15 * valueNoise(ns * 47.0);
        vec3 surface = blackbody(18000.0 * g) * (0.8 + 0.4 * mottle);
        vec3 hotCap = blackbody(30000.0 * g) * 5.0;
        radiance = mix(surface * 1.4, hotCap, cap) * limb;
    }
    return radiance * pow(g, 4.0);
}

// Glow collected along a ray segment near a neutron star (realistic look only):
//  - corona: a thin hot layer whose density falls off as exp(-(r - R) / (0.12 R));
//  - with the magnetosphere switched on: dipole magnetic field lines r = L sin²θ (θ measured from the
//    magnetic axis) for three shells L and six azimuths, and radiation cones along the magnetic axis.
// The glow is sampled along the (bent) ray, so it is lensed like everything else.
vec3 magnetosphereGlow(vec3 start, vec3 dir, float len) {
    float R = frame.compactSurface.x;
    if (R == 0.0 || diagnosticView()) return vec3(0.0);
    bool magnetosphere = (int(frame.compactSurface.w) & 2) != 0;
    vec3 axis = magneticAxis();
    vec3 e1 = normalize(cross(axis, abs(axis.y) < 0.9 ? vec3(0, 1, 0) : vec3(1, 0, 0)));
    vec3 e2 = cross(axis, e1);
    vec3 glow = vec3(0.0);
    for (int k = 0; k < 2; k++) {                              // two samples per segment
        vec3 q = start + dir * (len * (0.25 + 0.5 * float(k)));
        float r = length(q);
        if (r <= R) continue;
        float w = 0.5 * len;
        if (r < 2.0 * R) glow += vec3(0.55, 0.7, 1.0) * (0.5 * exp(-(r - R) / (0.1 * R)) / R) * w;   // corona
        if (!magnetosphere) continue;

        float cosTheta = dot(q / r, axis);
        float cone = smoothstep(cos(radians(13.0)), cos(radians(3.0)), abs(cosTheta));
        glow += vec3(0.5, 0.7, 1.0) * (0.05 * cone * exp(-(r - R) / (6.0 * R))) * w;     // beams
        if (r > 4.0 * R) continue;                                         // beyond the outermost field line

        float sin2 = max(1.0 - cosTheta * cosTheta, 1e-4);
        float phi = atan(dot(q, e2), dot(q, e1));
        float nearestPhi = round(phi / 1.0471975512) * 1.0471975512;     // six field-line planes
        float azimuthDistance = r * sqrt(sin2) * abs(phi - nearestPhi);
        for (int s = 0; s < 3; s++) {
            float L = R * (1.6 + 0.9 * float(s));
            float radialDistance = abs(r - L * sin2);
            float d2 = radialDistance * radialDistance + azimuthDistance * azimuthDistance;
            glow += vec3(0.6, 0.55, 1.0) * (1.0 * exp(-d2 / (0.006 * R * R) - (r - R) / (2.5 * R)) / R) * w;    // field lines
        }
    }
    return glow;
}

// Follows a camera ray past a compact object (black hole or neutron star). With gravity the ray is
// integrated along the exact Schwarzschild light path
//   dx/dλ = v,  dv/dλ = -3 M h² x / r⁵,  h = |x × v|   (RK4, dλ = 0.02 r)
// and without gravity the same steps are taken along a straight line. Each step's chord is checked
// against the surface (neutron star; for a black hole without gravity the horizon sphere), the accretion
// disk and the scene geometry (ray query). On return, (r, tMax) is the straight segment the caller traces next:
//   NONE    -> geometry lies on that segment (or the ray left the region: tMax = T_MAX)
//   DISK    -> the segment ends on the disk, no geometry before it; 'emitted' is the disk light
//   SURFACE -> the segment ends on the neutron star, no geometry before it; 'emitted' is its light
//   HORIZON -> the ray falls into the black hole (black)
// 'glow' collects the pulsar beam light along the way.
int marchCompactObject(inout Ray r, bool gravity, out float tMax, out vec3 emitted, out vec3 glow) {
    vec3 center = frame.blackHole.xyz;
    float M = frame.blackHole.w;
    float accel = gravity ? M : 0.0;
    bool blackHole = frame.compactSurface.x == 0.0;
    float surfaceRadius = blackHole ? (gravity ? 0.0 : 2.0 * M) : frame.compactSurface.x;
    bool disk = frame.blackHoleDisk.z > 0.0;
    emitted = vec3(0.0);
    glow = vec3(0.0);
    tMax = T_MAX;

    vec3 x = r.origin - center;
    float radius = length(x);
    // Direction seen by the (static) camera -> integration velocity: radial part scaled by √(1 - 2M/r).
    vec3 radialDir = x / radius;
    vec3 v = r.dir;
    if (gravity) v -= (1.0 - sqrt(max(1.0 - 2.0 * M / radius, 0.0))) * dot(r.dir, radialDir) * radialDir;
    vec3 hv = cross(x, v);
    float h2 = dot(hv, hv);

    for (int i = 0; i < BH_MAX_STEPS; i++) {
        radius = length(x);
        float outward = dot(x, v);
        if (gravity && blackHole && radius < 3.0 * M && outward < 0.0) {
            return BH_EVENT_HORIZON; // inside the photon sphere, falling in
        }
        if (radius > BH_ESCAPE * M && outward > 0.0) {
            r.origin = x + center;
            r.dir = normalize(v);
            return BH_EVENT_NONE;    // far away: straight from here
        }

        // One RK4 step of length dl (zero acceleration without gravity).
        float dl = BH_STEP_FACTOR * radius;
        vec3 x0 = x;
        vec3 k1x = v;                       vec3 k1v = -3.0 * accel * h2 * x / pow(dot(x, x), 2.5);
        vec3 x2 = x + 0.5 * dl * k1x;       vec3 k2x = v + 0.5 * dl * k1v;  vec3 k2v = -3.0 * accel * h2 * x2 / pow(dot(x2, x2), 2.5);
        vec3 x3 = x + 0.5 * dl * k2x;       vec3 k3x = v + 0.5 * dl * k2v;  vec3 k3v = -3.0 * accel * h2 * x3 / pow(dot(x3, x3), 2.5);
        vec3 x4 = x + dl * k3x;             vec3 k4x = v + dl * k3v;        vec3 k4v = -3.0 * accel * h2 * x4 / pow(dot(x4, x4), 2.5);
        x += dl / 6.0 * (k1x + 2.0 * k2x + 2.0 * k3x + k4x);
        v += dl / 6.0 * (k1v + 2.0 * k2v + 2.0 * k3v + k4v);

        vec3 chord = x - x0;
        float chordLength = length(chord);
        vec3 chordDir = chord / chordLength;

        // Surface sphere: first crossing along the chord.
        float surfaceT = -1.0;
        if (surfaceRadius > 0.0) {
            float b = dot(x0, chordDir);
            float c = dot(x0, x0) - surfaceRadius * surfaceRadius;
            float discriminant = b * b - c;
            if (discriminant >= 0.0) {
                float t = -b - sqrt(discriminant);
                if (t >= 0.0 && t <= chordLength) surfaceT = t;
            }
        }

        // Disk: the chord crosses the y = 0 plane between the inner and outer radius.
        float diskT = -1.0;
        vec3 diskPoint;
        if (disk && x0.y * x.y < 0.0) {
            float f = x0.y / (x0.y - x.y);
            diskPoint = mix(x0, x, f);
            float diskRadius = length(diskPoint);
            if (diskRadius >= frame.blackHoleDisk.x && diskRadius <= frame.blackHoleDisk.y) {
                diskT = f * chordLength;
            }
        }

        float segmentEnd = chordLength;
        if (surfaceT >= 0.0) segmentEnd = surfaceT;
        if (diskT >= 0.0 && diskT < segmentEnd) segmentEnd = diskT;

        glow += magnetosphereGlow(x0, chordDir, segmentEnd);

        if (segmentHitsGeometry(x0 + center, chordDir, segmentEnd)) {
            r.origin = x0 + center;
            r.dir = chordDir;
            tMax = segmentEnd * 1.0001 + T_MIN;
            return BH_EVENT_NONE;
        }
        if (surfaceT >= 0.0 && (diskT < 0.0 || surfaceT <= diskT)) {
            r.origin = x0 + center;
            r.dir = chordDir;
            tMax = max(surfaceT, T_MIN * 2.0);
            if (blackHole) return BH_EVENT_HORIZON;          // straight light into the horizon sphere
            emitted = surfaceEmission(x0 + surfaceT * chordDir, chordDir, gravity);
            return BH_EVENT_SURFACE;
        }
        if (diskT >= 0.0) {
            r.origin = x0 + center;
            r.dir = chordDir;
            tMax = max(diskT, T_MIN * 2.0);
            emitted = diskEmission(diskPoint, v, h2, gravity);
            return BH_EVENT_DISK;
        }
    }
    return blackHole ? BH_EVENT_HORIZON : BH_EVENT_NONE;
}

// --- Main ---
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imageSize = imageSize(resultImage);
    if (pixel.x >= imageSize.x || pixel.y >= imageSize.y) return;

    // A different random sequence per pixel and per sample, so samples average out.
    seed = pcg(uint(pixel.y * imageSize.x + pixel.x) ^ pcg(frame.sampleIndex * 0x9E3779B9u + 1u));

    // Anti-aliasing jitter, with the image flipped vertically
    float u = (float(pixel.x) + randomFloat()) / float(imageSize.x);
    float v = (float(imageSize.y - 1 - pixel.y) + randomFloat()) / float(imageSize.y);

    Ray r;
    r.origin = frame.origin.xyz;
    r.dir = normalize(frame.lowerLeft.xyz + frame.horizontal.xyz * u + frame.vertical.xyz * v - frame.origin.xyz);

    vec3 radiance = vec3(0.0);
    vec3 throughput = vec3(1.0);
    bool lightSampledAtLastHit = false; // last bounce was diffuse and sampled the sphere lights

    // Black hole / neutron star scenes: the camera ray first follows its path past the compact object
    // (bent, or straight with gravity off); the bounce loop then continues with the resulting straight
    // segment. In split view the left half of the image always uses straight light.
    float firstTMax = T_MAX;
    uint bounces = frame.maxBounces;
    bool splitView = (int(frame.compactSurface.w) & 1) != 0;
    if (frame.blackHole.w > 0.0) {
        bool gravity = frame.blackHoleDisk.w > 0.5 && !(splitView && pixel.x < imageSize.x / 2);
        vec3 emitted, glow;
        int event = marchCompactObject(r, gravity, firstTMax, emitted, glow);
        radiance += glow;
        if (event == BH_EVENT_HORIZON) {
            bounces = 0u;                        // black
        } else if (event == BH_EVENT_DISK || event == BH_EVENT_SURFACE) {
            radiance += emitted;
            bounces = 0u;
        }
    }

    for (uint bounce = 0u; bounce < bounces; bounce++) {
        Hit hit;
        if (!traceRay(r, bounce == 0u ? firstTMax : T_MAX, hit)) {
            radiance += throughput * getSkyColor(r.dir);
            break;
        }
        InstanceInfo material = instances[hit.instance];
        if (material.materialType == MAT_EMISSIVE) {
            // Sphere lights reached by a diffuse bounce were already counted by sampleSphereLight.
            bool countedByLightSampling = lightSampledAtLastHit && material.geometryType == GEOMETRY_SPHERE;
            if (!countedByLightSampling) {
                radiance += throughput * material.emissionIor.rgb;
            }
            break;
        }

        vec3 hitPos = r.origin + r.dir * hit.t;
        lightSampledAtLastHit = false;
        if (material.materialType == MAT_DIFFUSE && frame.lightCount > 0u) {
            vec3 lightOrigin = offsetOrigin(hitPos, hit.normal, hit.normal);
            radiance += throughput * material.albedoRoughness.rgb * sampleSphereLight(lightOrigin, hit.normal);
            lightSampledAtLastHit = true;
        }

        vec3 attenuation;
        vec3 nextDir;
        if (!scatter(r.dir, hit, material, attenuation, nextDir)) {
            break;
        }
        throughput *= attenuation;

        // Russian roulette: after a few bounces, end dim paths early without biasing the result.
        if (bounce >= 3u) {
            float survive = clamp(max(throughput.r, max(throughput.g, throughput.b)), 0.05, 0.98);
            if (randomFloat() > survive) break;
            throughput /= survive;
        }

        r.origin = offsetOrigin(hitPos, hit.normal, nextDir);
        r.dir = nextDir;
    }

    // Guard against NaN/Inf and rare extreme samples (fireflies) before averaging.
    if (any(isnan(radiance)) || any(isinf(radiance))) radiance = vec3(0.0);
    radiance = min(radiance, vec3(100.0));
    if (splitView && frame.blackHole.w > 0.0 && abs(pixel.x - imageSize.x / 2) < 1) {
        radiance = vec3(0.35); // divider: straight light on the left, bent light on the right
    }

    // Running average over all samples since the last change.
    vec3 average = radiance;
    if (frame.sampleIndex > 0u) {
        vec3 previous = imageLoad(accumImage, pixel).rgb;
        average = previous + (radiance - previous) / float(frame.sampleIndex + 1u);
    }
    imageStore(accumImage, pixel, vec4(average, 1.0));

    // Exposure, tone mapping, gamma 2.2. Stored as B, G, R, A so that the bytes read back on the
    // CPU are, as a little-endian int, 0xAARRGGBB: exactly the layout of a Java TYPE_INT_RGB image.
    vec3 display = pow(acesFilm(average * exp2(frame.exposure)), vec3(1.0 / 2.2));
    imageStore(resultImage, pixel, vec4(display.b, display.g, display.r, 1.0));
}
