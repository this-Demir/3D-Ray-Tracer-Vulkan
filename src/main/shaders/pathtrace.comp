#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

/*
 * Path tracer using hardware ray tracing (RT cores) through ray queries.
 * The scene is a top-level acceleration structure (TLAS) over instances; each instance
 * points at a mesh BLAS. Per-instance data (mesh buffers, material) lives in InstanceBuffer.
 */

// --- Data layout (must match RayTracingScene.java / VulkanEngine.java) ---
struct Ray { vec3 origin; vec3 dir; };

struct InstanceInfo {
    uint64_t vertexAddress;   // float x, y, z per vertex (object space)
    uint64_t indexAddress;    // uint, three per triangle
    vec4     albedoAndType;   // rgb = albedo, a = material type
};

layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer Positions { float v[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer Indices { uint i[]; };

// --- Bindings ---
layout(rgba8, set = 0, binding = 0) uniform restrict writeonly image2D resultImage;
layout(set = 0, binding = 1) uniform accelerationStructureEXT topLevelAS;
layout(std430, set = 0, binding = 2) readonly buffer InstanceBuffer { InstanceInfo instances[]; };
layout(std140, set = 0, binding = 3) uniform CameraUBO {
    vec3 origin;
    vec3 lower_left_corner;
    vec3 horizontal;
    vec3 vertical;
} cam;

// --- Constants ---
const float T_MIN = 0.001;
const float T_MAX = 10000.0;
const int   MAX_BOUNCES = 10;
const float MAT_LAMBERTIAN  = 0.0;
const float MAT_METAL       = 1.0;
const float MAT_METAL_FUZZY = 2.0;
const float MAT_EMISSIVE    = 3.0;

// --- Random numbers (PCG hash) ---
uint seed;

uint pcg(uint v) {
    uint state = v * 747796405u + 2891336453u;
    uint word  = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float randomFloat() {
    seed = pcg(seed);
    return float(seed) / float(0xFFFFFFFFu);
}

vec3 randomVec3InUnitSphere() {
    for (;;) {
        vec3 p = vec3(randomFloat(), randomFloat(), randomFloat()) * 2.0 - 1.0;
        if (dot(p, p) < 1.0) return p;
    }
}

vec3 randomUnitVector() {
    return normalize(randomVec3InUnitSphere());
}

vec3 getSkyColor(Ray r) {
    vec3 unit_direction = normalize(r.dir);
    float t = 0.5 * (unit_direction.y + 1.0);
    return (1.0 - t) * vec3(1.0) + t * vec3(0.5, 0.7, 1.0);
}

// --- Hit information from the committed ray-query intersection ---
struct Hit {
    float t;
    vec3  normal;    // world space, facing against the ray
    vec4  material;  // rgb = albedo, a = type
};

bool traceRay(Ray r, out Hit hit) {
    rayQueryEXT query;
    rayQueryInitializeEXT(query, topLevelAS, gl_RayFlagsOpaqueEXT, 0xFF, r.origin, T_MIN, r.dir, T_MAX);
    while (rayQueryProceedEXT(query)) {
        // All geometry is opaque, so the hardware commits the closest triangle by itself.
    }
    if (rayQueryGetIntersectionTypeEXT(query, true) == gl_RayQueryCommittedIntersectionNoneEXT) {
        return false;
    }

    InstanceInfo instance = instances[rayQueryGetIntersectionInstanceCustomIndexEXT(query, true)];
    int primitive = rayQueryGetIntersectionPrimitiveIndexEXT(query, true);

    Indices indices = Indices(instance.indexAddress);
    Positions positions = Positions(instance.vertexAddress);
    uint i0 = indices.i[3 * primitive];
    uint i1 = indices.i[3 * primitive + 1];
    uint i2 = indices.i[3 * primitive + 2];
    vec3 v0 = vec3(positions.v[3 * i0], positions.v[3 * i0 + 1], positions.v[3 * i0 + 2]);
    vec3 v1 = vec3(positions.v[3 * i1], positions.v[3 * i1 + 1], positions.v[3 * i1 + 2]);
    vec3 v2 = vec3(positions.v[3 * i2], positions.v[3 * i2 + 1], positions.v[3 * i2 + 2]);

    // Object-space face normal to world space: n_world = transpose(inverse(M)) * n = n * WorldToObject.
    vec3 objectNormal = cross(v1 - v0, v2 - v0);
    mat4x3 worldToObject = rayQueryGetIntersectionWorldToObjectEXT(query, true);
    vec3 normal = normalize((objectNormal * worldToObject).xyz);
    if (dot(r.dir, normal) > 0.0) normal = -normal;

    hit.t = rayQueryGetIntersectionTEXT(query, true);
    hit.normal = normal;
    hit.material = instance.albedoAndType;
    return true;
}

// --- Materials ---
bool scatter(Ray r_in, vec4 material, vec3 hit_pos, vec3 hit_normal,
             out vec3 attenuation, out Ray scattered) {
    vec3 albedo = material.rgb;
    float type = material.a;

    if (type == MAT_LAMBERTIAN) {
        vec3 scatter_direction = hit_normal + randomUnitVector();
        if (length(scatter_direction) < 0.0001) scatter_direction = hit_normal;
        scattered   = Ray(hit_pos, normalize(scatter_direction));
        attenuation = albedo;
        return true;
    }

    if (type == MAT_METAL || type == MAT_METAL_FUZZY) {
        float fuzz     = (type == MAT_METAL_FUZZY) ? 0.3 : 0.0;
        vec3 reflected = reflect(normalize(r_in.dir), hit_normal);
        scattered      = Ray(hit_pos, normalize(reflected + fuzz * randomVec3InUnitSphere()));
        attenuation    = albedo;
        return (dot(scattered.dir, hit_normal) > 0.0);
    }

    return false; // emissive and unknown materials do not scatter
}

// --- Main ---
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
void main() {
    ivec2 pixel_coords = ivec2(gl_GlobalInvocationID.xy);
    ivec2 image_size   = imageSize(resultImage);
    if (pixel_coords.x >= image_size.x || pixel_coords.y >= image_size.y) return;

    seed = uint(pixel_coords.y * image_size.x + pixel_coords.x);

    // Anti-aliasing jitter, with the image flipped vertically
    float u = (float(pixel_coords.x) + randomFloat()) / float(image_size.x);
    float v = (float(image_size.y - 1 - pixel_coords.y) + randomFloat()) / float(image_size.y);

    Ray r;
    r.origin = cam.origin;
    r.dir = normalize(cam.lower_left_corner + cam.horizontal * u + cam.vertical * v - cam.origin);

    vec3 final_color = vec3(0.0);
    vec3 attenuation = vec3(1.0);

    for (int b = 0; b < MAX_BOUNCES; b++) {
        Hit hit;
        if (!traceRay(r, hit)) {
            final_color = attenuation * getSkyColor(r);
            break;
        }

        if (hit.material.a == MAT_EMISSIVE) {
            final_color = attenuation * hit.material.rgb;
            break;
        }

        vec3 hit_pos = r.origin + r.dir * hit.t;
        vec3 mat_attenuation;
        Ray scattered;
        if (!scatter(r, hit.material, hit_pos, hit.normal, mat_attenuation, scattered)) {
            break; // absorbed: final_color stays black
        }
        attenuation *= mat_attenuation;
        r = scattered;
        // A path still bouncing after MAX_BOUNCES contributes nothing (final_color stays black).
    }

    // Gamma ~2 (sqrt)
    imageStore(resultImage, pixel_coords, vec4(sqrt(final_color), 1.0));
}
